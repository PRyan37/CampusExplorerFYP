rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // ---------- users ----------
    match /users/{userId} {
      // any signed-in user can read profiles
      allow read: if signedIn();

      // all writes are done via Cloud Functions (admin SDK)
      allow write: if false;
    }

    // ---------- friendRequests ----------
    match /friendRequests/{requestId} {
      // only sender or recipient can read
      allow get, list: if signedIn()
        && (resource.data.fromUserId == uid() || resource.data.toUserId == uid());

      // created/updated/deleted only by Cloud Functions
      allow write: if false;
    }

    // ---------- friends ----------
    match /friends/{friendDocId} {
      // user can read only docs where they are userId
      allow get, list: if signedIn() && resource.data.userId == uid();

      // writes only via Cloud Functions
      allow write: if false;
    }

    // ---------- notifications ----------
    //  notifications/{userId}/inbox/{notifId}
    match /notifications/{userId}/inbox/{notifId} {
      // only owner reads
      allow get, list: if signedIn() && userId == uid();

      // optionally allow owner to mark 'read' flag only
      allow update: if signedIn()
        && userId == uid()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      // creates/deletes done only by Cloud Functions
      allow create, delete: if false;
    }

    // ---------- campusLocations ----------
    match /campusLocations/{locationId} {
      // public read (map, journey, etc.)
      allow read: if true;
      // only Cloud Functions / admin write
      allow write: if false;
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}